<%# Hover detail for a card. %>
<div class="ea-tooltip">
  <h3><%= link_to "#{issue.tracker.name} ##{issue.id}", issue_path(issue) %></h3>
  <p class="ea-tooltip-subject"><strong><%= h issue.subject %></strong></p>
  <ul class="ea-tooltip-attributes">
    <li><%= l(:field_status) %>: <%= h issue.status.name %></li>
    <li><%= l(:field_priority) %>: <%= h issue.priority.name %></li>
    <li><%= l(:field_assigned_to) %>: <%= issue.assigned_to ? h(issue.assigned_to.name) : '-' %></li>
    <%# The card's whole path in the tree: its epic, and the story between
        the two for a story's subtask. %>
    <% if (epic = RedmineExpertAgile::Epics.enabled? && RedmineExpertAgile::Epics.nearest([issue])[issue.id]) %>
      <% story = RedmineExpertAgile::Hierarchy.parents([issue])[issue.id] %>
      <% story = nil if story.nil? || story.id == epic.id %>
      <li class="ea-tooltip-lineage">
        <%= l(:label_expert_agile_epic) %>:
        <%= link_to "##{epic.id} #{epic.subject}", issue_path(epic) %>
        <% if story %> › <%= link_to "##{story.id} #{story.subject}", issue_path(story) %><% end %>
        › #<%= issue.id %>
      </li>
    <% end %>
    <% if issue.story_points.present? %>
      <li><%= l(:label_expert_agile_story_points) %>: <%= issue.story_points %></li>
    <% end %>
    <% if issue.due_date %>
      <li><%= l(:field_due_date) %>: <%= format_date(issue.due_date) %></li>
    <% end %>
  </ul>
  <% if issue.description.present? %>
    <div class="ea-tooltip-description"><%= textilizable issue, :description %></div>
  <% end %>
</div>
