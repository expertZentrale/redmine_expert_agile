<%# The board's configuration: filters, card fields, appearance, status columns
    and WIP limits.

    Modelled on Redmine's queries/_query_form so it behaves the way every other
    Redmine filter panel does — collapsible fieldsets, the same filter widget,
    the same column picker. Filters, card fields, grouping and sorting are core
    partials; the board-specific settings sit in their own fieldset below.

    Rendered both by the board's own options panel and by the saved-board form,
    so a saved board is edited with the same controls it was created with rather
    than through a page that can only rename it. It therefore emits everything
    needed to rebuild the configuration from the request and nothing that only
    makes sense on the board page — the Apply/Clear/Save buttons stay with the
    caller.

    Note: Redmine's own filters partial emits an inline <script> block. The
    board *content* — columns and cards, which are also re-injected after a
    move — stays free of inline script; this panel inherits whatever core
    does, because it is core's markup. %>

<%= hidden_field_tag 'set_filter', '1' %>

<%# On the page this configures, the filters open only for a new view and the
    options always start folded, so the page leads with content rather than with
    a filter table. The save form passes `expanded` to override both: there,
    changing the configuration is the point of the page. %>
<% expanded = local_assigns[:expanded] %>
<% filters_expanded = expanded.nil? ? @query.new_record? : expanded %>
<fieldset id="filters" class="collapsible <%= filters_expanded ? '' : 'collapsed' %>">
  <legend onclick="toggleFieldset(this);" class="icon icon-<%= filters_expanded ? 'expanded' : 'collapsed' %>">
    <%= l(:label_filter_plural) %>
  </legend>
  <div style="<%= filters_expanded ? '' : 'display: none;' %>">
    <%= render :partial => 'queries/filters', :locals => { :query => @query } %>
  </div>
</fieldset>

<fieldset id="options" class="collapsible <%= expanded ? '' : 'collapsed' %>">
  <legend onclick="toggleFieldset(this);" class="icon icon-<%= expanded ? 'expanded' : 'collapsed' %>"><%= l(:label_options) %></legend>
  <div class="<%= 'hidden' unless expanded %>">
    <%# One grid of three panels rather than three stacked fieldsets with a
        400px dual-listbox in the middle. Everything a board is configured
        with is visible at once. %>
    <div class="ea-options-grid">

      <section class="ea-options-panel">
        <h4><%= l(:label_expert_agile_card_fields) %></h4>
        <div class="ea-field-options">
          <%= expert_agile_card_field_tags(@query) %>
        </div>
      </section>

      <section class="ea-options-panel">
        <h4><%= l(:label_expert_agile_appearance) %></h4>
        <p class="ea-options-row">
          <label for="group_by"><%= l(:label_expert_agile_swimlanes) %></label>
          <%= group_by_column_select_tag(@query) %>
        </p>
        <p class="ea-options-row">
          <label for="color_base"><%= l(:label_expert_agile_color_base) %></label>
          <%= select_tag 'color_base',
                         options_for_select(
                           RedmineExpertAgile::COLOR_BASES.map { |b| [l("label_expert_agile_color_base_#{b}"), b] },
                           @query.color_base) %>
        </p>
        <p class="ea-options-row">
          <label for="show_avatar"><%= l(:label_expert_agile_show_avatar) %></label>
          <span>
            <%= hidden_field_tag 'show_avatar', '0' %>
            <%= check_box_tag 'show_avatar', '1', @query.show_avatar? %>
          </span>
        </p>
      </section>

      <section class="ea-options-panel" id="ea-columns-options">
        <h4><%= l(:label_expert_agile_columns_and_limits) %></h4>
        <p class="ea-hint"><%= l(:text_expert_agile_board_statuses_hint) %></p>
        <% selected = @query.board_statuses.map(&:id) %>
        <% limits = @query.wip_limits %>
        <%= hidden_field_tag 'board_status_ids[]', '' %>
        <div class="ea-status-grid">
          <span class="ea-status-grid-head"><%= l(:field_status) %></span>
          <span class="ea-status-grid-head"><%= l(:label_expert_agile_wip_min) %></span>
          <span class="ea-status-grid-head"><%= l(:label_expert_agile_wip_max) %></span>
          <% expert_agile_selectable_statuses(@query).each do |status| %>
            <label class="ea-status-name<%= ' ea-status-closed' if status.is_closed? %>">
              <%= check_box_tag 'board_status_ids[]', status.id,
                                selected.include?(status.id), :id => "ea_status_#{status.id}" %>
              <%= h status.name %>
            </label>
            <%= text_field_tag "wip_limits[#{status.id}][]", limits[status.id] && limits[status.id][0],
                               :size => 2, :id => nil, :class => 'ea-wip-input' %>
            <%= text_field_tag "wip_limits[#{status.id}][]", limits[status.id] && limits[status.id][1],
                               :size => 2, :id => nil, :class => 'ea-wip-input' %>
          <% end %>
        </div>
      </section>

    </div>
  </div>
</fieldset>
