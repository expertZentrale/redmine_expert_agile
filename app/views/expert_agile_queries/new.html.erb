<%# Shared by the board, chart and backlog variants: the controller decides
    where this posts and what it is called, so all three save as their own kind. %>
<h2><%= query_page_title %></h2>

<%= form_tag(query_collection_path) do %>
  <%= fields_for :query, @query do |f| %>
    <%= render :partial => 'form', :locals => { :f => f } %>
  <% end %>
  <%= submit_tag l(:button_save) %>
<% end %>

<%# The panel is the board's own markup, so it needs the board's stylesheet. %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'expert_agile', :plugin => 'redmine_expert_agile' %>
<% end %>
