<%# Backlog planner. Markup only; configuration travels in the JSON island. %>
<h2><%= l(:label_expert_agile_backlog) %></h2>

<div class="ea-backlog-switch">
  <%= link_to l(:label_expert_agile_sprint_plural),
              project_expert_agile_backlog_path(@project, :container_type => 'sprint'),
              :class => (@query.sprints? ? 'selected' : nil) %>
  <%= link_to l(:label_version_plural),
              project_expert_agile_backlog_path(@project, :container_type => 'version'),
              :class => (@query.sprints? ? nil : 'selected') %>
</div>

<div id="ea-backlog" class="ea-backlog">
  <%= render :partial => 'expert_agile_backlogs/lane', :locals => { :container => nil } %>
  <% @query.containers.each do |container| %>
    <%= render :partial => 'expert_agile_backlogs/lane', :locals => { :container => container } %>
  <% end %>
</div>

<script type="application/json" id="ea-board-data"><%= expert_agile_backlog_data(@query, @project).html_safe %></script>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'expert_agile', :plugin => 'redmine_expert_agile' %>
  <%= javascript_include_tag 'expert_agile_board', :plugin => 'redmine_expert_agile' %>
<% end %>

<% html_title(l(:label_expert_agile_backlog)) %>
