<%# Backlog planner. Markup only; configuration travels in the JSON island. %>
<h2><%= @query.new_record? ? l(:label_expert_agile_backlog) : h(@query.name) %></h2>

<%# The container switch and the layout switch stay pairs of links rather than
    moving into the options panel: they are the settings worth a single click,
    and the panel carries both as hidden fields so applying a filter keeps
    them. Each link carries the other switch's value too, so a saved planner
    tweaked for this request keeps the tweak. %>
<div class="ea-backlog-switches">
  <div class="ea-backlog-switch ea-backlog-container-switch">
    <%= link_to l(:label_expert_agile_sprint_plural),
                backlog_path_for(@project, :container_type => 'sprint', :planner_layout => @query.planner_layout,
                                           :query_id => @query.id),
                :class => (@query.sprints? ? 'selected' : nil) %>
    <%= link_to l(:label_version_plural),
                backlog_path_for(@project, :container_type => 'version', :planner_layout => @query.planner_layout,
                                           :query_id => @query.id),
                :class => (@query.container_type == 'version' ? 'selected' : nil) %>
    <% if RedmineExpertAgile::Epics.enabled? %>
      <%= link_to l(:label_expert_agile_epic_plural),
                  backlog_path_for(@project, :container_type => 'epic', :planner_layout => @query.planner_layout,
                                             :query_id => @query.id),
                  :class => (@query.epics? ? 'selected' : nil) %>
    <% end %>
  </div>
  <div class="ea-backlog-switch ea-backlog-layout-switch">
    <%= link_to l(:label_expert_agile_planner_layout_columns),
                backlog_path_for(@project, :planner_layout => 'columns', :container_type => @query.container_type,
                                           :query_id => @query.id),
                :class => (@query.list_layout? ? nil : 'selected') %>
    <%= link_to l(:label_expert_agile_planner_layout_list),
                backlog_path_for(@project, :planner_layout => 'list', :container_type => @query.container_type,
                                           :query_id => @query.id),
                :class => (@query.list_layout? ? 'selected' : nil) %>
  </div>
</div>

<%= form_tag(backlog_path_for(@project), :method => :get, :id => 'ea_query_form') do %>
  <%= render :partial => 'expert_agile_backlogs/backlog_form' %>
<% end %>

<div class="ea-planner<%= ' ea-planner-with-panel' if @query.epic_panel? %>">
  <% if @query.epic_panel? %>
    <%= render :partial => 'expert_agile_backlogs/epic_panel' %>
  <% end %>

  <%# Redmine's own issue context menu on the cards, as on the board:
      context_menu.js reads the menu's address from the form around the card
      and sends the ids[] of the selected cards and back_url with it. Nothing
      submits this form; it only holds those fields. %>
  <% context_menu %>
  <%= content_tag(:form, :id => 'ea-board-form', :class => 'ea-planner-lanes',
                         :data => { :cm_url => issues_context_menu_path }) do %>
    <%= hidden_field_tag 'back_url', url_for(:params => request.query_parameters), :id => nil %>
    <div id="ea-backlog" class="ea-backlog<%= ' ea-backlog-list' if @query.list_layout? %>">
      <% @query.lanes.each do |container| %>
        <% if container.nil? && @query.containers.empty? && @query.list_layout? %>
          <%= render :partial => 'expert_agile_backlogs/no_containers' %>
        <% end %>
        <%= render :partial => 'expert_agile_backlogs/lane', :locals => { :container => container } %>
        <% if container.nil? && @query.containers.empty? && !@query.list_layout? %>
          <%= render :partial => 'expert_agile_backlogs/no_containers' %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<script type="application/json" id="ea-board-data"><%= expert_agile_backlog_data(@query, @project).html_safe %></script>

<% content_for :sidebar do %>
  <%= render :partial => 'expert_agile_common/sidebar',
             :locals => { :sidebar_query_class => ExpertAgileBacklogQuery,
                          :sidebar_title => l(:label_expert_agile_backlog_plural) } %>
<% end %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'expert_agile', :plugin => 'redmine_expert_agile' %>
  <%= javascript_include_tag 'expert_agile_board', :plugin => 'redmine_expert_agile' %>
<% end %>

<% html_title(l(:label_expert_agile_backlog)) %>
