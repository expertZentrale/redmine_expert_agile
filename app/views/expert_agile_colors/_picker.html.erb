<%# The palette as the colours themselves rather than as a list of their names.
    Radio buttons underneath, so the group stays keyboard-reachable and posts
    exactly what the select posted before: a palette name, or '' for no colour.

    Locals: name (form field name), id_prefix (unique per group), selected. %>
<div class="ea-color-choice">
  <label class="ea-color-option" title="<%= l(:label_none) %>">
    <%= radio_button_tag name, '', selected.blank?,
                         :id => "#{id_prefix}_none", :'aria-label' => l(:label_none) %>
    <span class="ea-color-swatch ea-color-none"></span>
  </label>

  <% ExpertAgileColor::COLORS.each do |color| %>
    <% caption = l("label_expert_agile_color_#{color}") %>
    <label class="ea-color-option" title="<%= caption %>">
      <%= radio_button_tag name, color, selected.to_s == color,
                           :id => "#{id_prefix}_#{color}", :'aria-label' => caption %>
      <span class="ea-color-swatch ea-color-<%= color %>"></span>
    </label>
  <% end %>
</div>
