<%= error_messages_for @sprint %>

<div class="box tabular">
  <p><%= f.text_field :name, :size => 60, :required => true %></p>
  <p><%= f.text_area :description, :rows => 4, :cols => 60 %></p>
  <p><%= f.date_field :start_date, :size => 10, :required => true %></p>
  <p><%= f.date_field :end_date, :size => 10, :required => true %></p>
  <p>
    <%= f.select :status,
                 ExpertAgileSprint::STATUSES.map { |value, key| [l("label_expert_agile_sprint_status_#{key}"), value] } %>
  </p>
  <p>
    <%= f.select :sharing,
                 ExpertAgileSprint::SHARINGS.map { |value, key| [l("label_expert_agile_sprint_sharing_#{key}"), value] } %>
  </p>
</div>
