<div class="contextual">
  <%= link_to l(:label_expert_agile_sprint_new), new_project_expert_agile_sprint_path(@project),
              :class => 'icon icon-add' %>
</div>

<h2><%= l(:label_expert_agile_sprint_plural) %></h2>

<% if @sprints.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:field_start_date) %></th>
        <th><%= l(:field_due_date) %></th>
        <th><%= l(:label_expert_agile_sprint_sharing_none) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @sprints.each do |sprint| %>
        <tr class="ea-sprint ea-sprint-<%= sprint.status_name %>">
          <td><%= h sprint.name %></td>
          <td><%= l("label_expert_agile_sprint_status_#{sprint.status_name}") %></td>
          <td><%= format_date(sprint.start_date) %></td>
          <td><%= format_date(sprint.end_date) %></td>
          <td><%= l("label_expert_agile_sprint_sharing_#{sprint.sharing_name}") %></td>
          <td class="buttons">
            <%= link_to l(:button_edit),
                        edit_project_expert_agile_sprint_path(@project, sprint),
                        :class => 'icon icon-edit' %>
            <%= link_to l(:button_delete),
                        project_expert_agile_sprint_path(@project, sprint),
                        :method => :delete, :data => { :confirm => l(:text_are_you_sure) },
                        :class => 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% html_title(l(:label_expert_agile_sprint_plural)) %>
