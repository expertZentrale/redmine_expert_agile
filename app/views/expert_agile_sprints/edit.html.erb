<h2><%= h @sprint.name %></h2>

<%= labelled_form_for @sprint, :url => project_expert_agile_sprint_path(@project, @sprint),
                      :as => :expert_agile_sprint, :html => { :method => :put } do |f| %>
  <%= render :partial => 'form', :locals => { :f => f } %>
  <%= submit_tag l(:button_save) %>
<% end %>
